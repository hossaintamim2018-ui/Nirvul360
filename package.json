{
  "name": "nirvul360-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Nirvul360 - Automated accounting for Bangladeshi e-commerce and f-commerce merchants",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:backend": "python backend/run_backend.py",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "test": "npm run test:frontend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:backend": "pytest backend/tests/ -v",
    "seed:backend": "python backend/seed.py"
  }
}
